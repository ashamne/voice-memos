# voice-memos configuration
# Copy to ~/.config/voice-memos/config and edit as needed.
# All settings have sensible defaults — you only need to set OUTPUT_DIR.

# --- Required ----------------------------------------------------------------

# Directory containing weekly notes. The script looks for files named
# W{nn}-{YYYY}.md (e.g. W15-2026.md) and appends transcripts under the
# "## Notes & Captures" section. Notes must already exist.
OUTPUT_DIR="$HOME/Brain/Calendar/Weekly"

# --- Optional ----------------------------------------------------------------

# Tag prepended to each transcript line (set to "" to disable)
OUTPUT_TAG="#voice-memo"

# Include timestamp (HH:MM:SS) in output line (true/false)
OUTPUT_TIMESTAMP=true

# Include recording duration in output line (true/false)
OUTPUT_DURATION=true

# Whisper language — "auto" to detect, or a language code (en, es, ru, etc.)
LANGUAGE="auto"

# Whisper model path (downloaded by install.sh)
WHISPER_MODEL="$HOME/.local/share/whisper-cpp/models/ggml-large-v3-turbo-q5_0.bin"

# Whisper command path
WHISPER_CMD="/opt/homebrew/bin/whisper-cli"
